<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.jcode.jcomercy</groupId>
    <artifactId>jcomercy-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>JComercy</name>
    <description>Ecosistema modular de productos de software para PyMEs</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Spring Boot 3.3.4 trae 1.19.8, que no se entiende con Docker 29 (responde 400 al detectar el motor). -->
        <testcontainers.version>1.21.4</testcontainers.version>
    </properties>

    <modules>
        <module>jcomercy-core</module>
        <module>company-management</module>
        <module>inventory</module>
    </modules>

    <profiles>
        <!--
            mvn -Prabbitmq test -Dtest='*RabbitMqIntegrationTest': activa las pruebas del Outbox contra un RabbitMQ real
            en un contenedor (necesita Docker). Sin el perfil se omiten, y la suite no necesita Docker. Se combina con
            -Ppostgres si se quieren los dos.
        -->
        <profile>
            <id>rabbitmq</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <jcomercy.test.broker>rabbitmq</jcomercy.test.broker>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
            mvn -Ppostgres test: las pruebas de Spring corren sobre un PostgreSQL real en un contenedor (necesita Docker)
            en lugar de H2. Sin el perfil, la suite usa H2 y no necesita Docker.
        -->
        <profile>
            <id>postgres</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <jcomercy.test.db>postgres</jcomercy.test.db>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
